<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for(:title) || "Smokestack BBQ Supply" %> · Smokestack BBQ Supply</title>
    <meta name="description" content="Grills, smokers, rubs, sauces and wood for people who cook with fire.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><text y='26' font-size='26'>&#128293;</text></svg>">
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 3c5 6-6 8 0 15 6-7-5-9 0-15Z"/>
              <path d="M6 21a10 10 0 0 0 20 0"/>
              <line x1="4" y1="21" x2="28" y2="21"/>
            </svg>
          </span>
          <span class="brand-text">Smokestack<em>BBQ Supply</em></span>
        <% end %>

        <%= form_with url: search_path, method: :get, class: "search", data: { turbo: false } do %>
          <label class="sr-only" for="q">Search the store</label>
          <input id="q" type="search" name="q" placeholder="brisket rub, post oak, thermometer…"
                 value="<%= params[:q] %>" autocomplete="off">
          <button type="submit" aria-label="Search">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/>
            </svg>
          </button>
        <% end %>

        <%= link_to cart_path, class: "cart-link" do %>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.5a2 2 0 0 0 2-1.55L21 8H6"/>
            <circle cx="10" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/>
          </svg>
          <span>Cart</span>
          <% if current_cart.count.positive? %>
            <span class="cart-count"><%= current_cart.count %></span>
          <% end %>
        <% end %>
      </div>

      <nav class="site-nav" aria-label="Product categories">
        <div class="wrap nav-inner">
          <% Category.ordered.each do |category| %>
            <%= link_to category.name, category_path(category.slug) %>
          <% end %>
          <%= link_to "Orders", orders_path, class: "nav-orders" %>
          <%= link_to "Demo", demo_path, class: "nav-demo" %>
        </div>
      </nav>
    </header>

    <% if notice.present? || alert.present? %>
      <div class="wrap">
        <% if notice.present? %>
          <div class="flash flash-success" role="status"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="flash flash-error" role="alert"><%= alert %></div>
        <% end %>
      </div>
    <% end %>

    <main id="main"><%= yield %></main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div>
          <strong>Smokestack BBQ Supply</strong>
          <p>A demo storefront for AppSignal. Rails <%= Rails.version %>, Ruby <%= RUBY_VERSION %>,
             monitoring <%= Appsignal.active? ? "active" : "inactive (no push API key set)" %>.</p>
        </div>
        <div class="footer-cols">
          <div>
            <h4>Shop</h4>
            <% Category.ordered.each do |category| %>
              <%= link_to category.name, category_path(category.slug) %>
            <% end %>
          </div>
          <div>
            <h4>Store</h4>
            <%= link_to "Cart", cart_path %>
            <%= link_to "Orders", orders_path %>
            <%= link_to "AppSignal demos", demo_path %>
            <%= link_to "Health check", health_path %>
          </div>
        </div>
      </div>
      <div class="wrap footer-legal">
        <span>Prices include 21% VAT · Free shipping over <%= money(Order::FREE_SHIPPING_THRESHOLD_CENTS) %></span>
        <span>Demo only — no payment is ever taken.</span>
      </div>
    </footer>
  </body>
</html>
