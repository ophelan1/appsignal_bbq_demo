<% content_for :title, "External HTTP" %>
<section class="wrap section">
  <nav class="crumbs"><%= link_to "Demos", demo_path %> <span>/</span> External HTTP</nav>
  <div class="section-head"><h1>Outbound request complete</h1></div>
  <div class="demo-result">
    <p>Called <code>https://api.github.com/zen</code> and got:</p>
    <blockquote><%= @result %></blockquote>
    <p class="muted">In the AppSignal trace this appears as its own event, so you can see how much
      of the request was spent waiting on someone else's server.</p>
  </div>
  <p><%= link_to "Back to demos", demo_path, class: "btn btn-ghost" %></p>
</section>
